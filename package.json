{
  "name": "readers-haven-library",
  "version": "1.0.0",
  "private": true,
  "description": "Readers' Haven Public Library: a static HTML and CSS website.",
  "scripts": {
    "start": "parcel \"src/*.html\"",
    "build": "parcel build \"src/*.html\" --dist-dir dist --public-url ./ --no-source-maps"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "parcel": "2.16.4"
  }
}
